{
  "name": "who-hacked-the-bot",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c magenta,cyan \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run typecheck -w server && npm run build -w client",
    "start": "npm run start -w server",
    "test": "vitest run",
    "sim": "tsx server/scripts/sim.ts",
    "ai:check": "tsx --use-system-ca server/scripts/ai-check.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "concurrently": "10.0.6"
  }
}
