# Copy this file to .env (git ignores .env) and fill in your values.
# Never commit .env or paste your key anywhere public.

# Port for the game server (Render sets this for you).
PORT=3001

# Your Anthropic API key, from https://console.anthropic.com (Settings → API keys).
# Leave empty to play with the pre-written Study-Bot lines instead.
ANTHROPIC_API_KEY=

# Which Claude model writes Study-Bot's explanations and the bots' meeting lines.
# claude-opus-5-5 (default, most capable), claude-sonnet-5-5, or claude-haiku-5-5 (fastest, cheapest).
CLAUDE_MODEL=claude-opus-5-5

# The game's own monthly cap in US dollars (default 5). It adds up what each Claude call
# costs and switches to the pre-written lines before going over. Also set a spend limit
# in the Claude Console (Settings > Limits) as a backstop.
AI_MONTHLY_LIMIT_USD=5

# Set to 1 to switch the AI off without removing your key.
AI_DISABLED=0
